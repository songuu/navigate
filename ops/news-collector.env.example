CONTENT_REPOSITORY_POSTGRES_ONLY=true
CONTENT_REPOSITORY_DRIVER=postgres
CONTENT_POSTGRES_WRITE_URL=postgresql://navigate_writer:REPLACE_PASSWORD@127.0.0.1:5432/navigate
CONTENT_POSTGRES_SSL=false
NEWS_DRY_RUN=false
NEWS_CRON=0 8 * * *
NEWS_TZ=Asia/Shanghai
NEWS_RUN_AT_BOOT=false
NEWS_FEED_CONCURRENCY=4
NEWS_FEED_TIMEOUT_MS=15000
NEWS_MAX_PER_SOURCE=30
# Horizon-style screening runs before article retrieval and translation.
NEWS_LOOKBACK_HOURS=24
NEWS_SKIP_EXISTING=true
NEWS_EDITORIAL_ENABLED=true
NEWS_EDITORIAL_MAX_ANALYZE=40
NEWS_EDITORIAL_THRESHOLD=7
NEWS_EDITORIAL_MAX_ITEMS=40
NEWS_EDITORIAL_MAX_PER_LAYER=10
NEWS_EDITORIAL_MAX_PER_SOURCE=5
NEWS_EDITORIAL_CONCURRENCY=2
NEWS_EDITORIAL_TIMEOUT_MS=30000
NEWS_EDITORIAL_MODEL=
NEWS_ARTICLE_CONTENT_ENABLED=true
NEWS_ARTICLE_CONTENT_TIMEOUT_MS=12000
NEWS_ARTICLE_CONTENT_MAX_ITEMS=80
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
NEWS_ENRICH_MAX=0
NEWS_TRANSLATION_ENABLED=false
NEWS_TRANSLATION_MAX_ITEMS=40
NEWS_TRANSLATION_CONCURRENCY=2
NEWS_TRANSLATION_TIMEOUT_MS=120000
NEWS_TRANSLATION_MAX_ATTEMPTS=2
# Retain existing production values when migrating; blank disables notifications.
NEWS_FEISHU_WEBHOOK_URL=
NEWS_FEISHU_WEBHOOK_SECRET=
NEWS_NOTIFY_ON_SOURCE_FAILURE=true
NEWS_NOTIFY_ON_CONTENT_FAILURE=false
NEWS_NOTIFY_ON_TRANSLATION_FAILURE=false

