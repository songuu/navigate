CONTENT_REPOSITORY_DRIVER=postgres
# Replace locally on the server; never commit the resulting .env file.
CONTENT_POSTGRES_READ_URL=postgresql://navigate_readonly:REPLACE_PASSWORD@127.0.0.1:5432/navigate
CONTENT_POSTGRES_SSL=false
CONTENT_API_ENABLED=1
CONTENT_API_HOST=127.0.0.1
CONTENT_API_PORT=5196
CONTENT_API_ALLOWED_HOSTS=songuu.top,127.0.0.1:5196,localhost:5196
CONTENT_API_ALLOWED_ORIGINS=https://songuu.top
CONTENT_API_ALLOW_MISSING_ORIGIN=true

