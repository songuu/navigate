[Unit]
Description=Validate Navigate news collection without Feishu notifications
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=navigate
Group=navigate
WorkingDirectory=/opt/navigate/current
Environment=NODE_ENV=production
Environment=CONTENT_REPOSITORY_POSTGRES_ONLY=true
Environment=CONTENT_REPOSITORY_DRIVER=postgres
RuntimeDirectory=navigate-news
# Process environment wins over Node's env-file, so only this manual run has
# notifications disabled; all database/model/translation settings stay intact.
ExecStart=/usr/bin/flock -n /run/navigate-news/collector.lock /usr/bin/env NEWS_FEISHU_WEBHOOK_URL= NEWS_FEISHU_WEBHOOK_SECRET= /usr/bin/node --experimental-transform-types --env-file=/opt/navigate/shared/news-collector.env news-collector/src/cli-collect.ts
Restart=no
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/navigate
StandardOutput=journal
StandardError=journal
