{
  "name": "songuu-navigate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Songuu 个人导航与 AI 资讯",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "content:api:prod": "node --experimental-transform-types --env-file=.env scripts/content-api/start-production.ts",
    "news:collect": "node --experimental-transform-types --env-file=.env news-collector/src/cli-collect.ts",
    "news:smoke": "node --experimental-transform-types news-collector/smoke.ts",
    "backend:test": "node scripts/run-backend-tests.mjs",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "news:cron": "node --experimental-transform-types --env-file=.env news-collector/src/cron.ts"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "rss-parser": "^3.13.0",
    "pg": "8.22.0",
    "node-cron": "^4.2.1",
    "dotenv": "^16.4.0",
    "openai": "^4.77.0",
    "@anthropic-ai/sdk": "^0.40.0",
    "mysql2": "^3.23.1"
  }
}
