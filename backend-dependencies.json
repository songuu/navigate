{
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "dotenv": "^16.4.0",
    "mysql2": "^3.23.1",
    "node-cron": "^4.2.1",
    "openai": "^4.77.0",
    "pg": "8.22.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
